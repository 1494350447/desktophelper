{
  "name": "desktophelper-app",
  "productName": "Desktophelper",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room real-time interview copilot overlay with no account system",
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "fetch:electron": "node scripts/fetch-electron.mjs",
    "setup": "node scripts/fetch-electron.mjs",
    "build": "node scripts/build.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "test": "node --test tests/*.test.ts",
    "test:all": "node scripts/build.mjs && node --test tests/*.test.ts",
    "start": "node scripts/run-electron.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package": "node scripts/package.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "verify": "node --test tests/*.test.ts && node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}